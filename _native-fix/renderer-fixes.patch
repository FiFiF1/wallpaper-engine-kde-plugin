diff --git a/src/Audio/include/Audio/AudioCapture.hpp b/src/Audio/include/Audio/AudioCapture.hpp
new file mode 100644
index 0000000..4a442ee
--- /dev/null
+++ b/src/Audio/include/Audio/AudioCapture.hpp
@@ -0,0 +1,74 @@
+#pragma once
+// System-audio capture + spectrum analysis for audio-reactive scenes.
+//
+// Wallpaper Engine scenes that declare the AUDIOPROCESSING combo sample two
+// uniforms, `g_AudioSpectrum16Left[16]` and `g_AudioSpectrum16Right[16]`.
+// This captures whatever is playing on the default output (the PulseAudio /
+// PipeWire ".monitor" source of the default sink) and reduces it to those two
+// 16-band spectra.
+//
+// One capture device is shared process-wide: plasmashell runs a separate scene
+// per monitor, and opening one input device per scene would show up as several
+// recording streams and waste CPU. Scenes Acquire()/Release() a reference and
+// the device is only open while at least one audio-reactive scene is live.
+#include <array>
+#include <cstdint>
+#include <memory>
+
+namespace wallpaper
+{
+
+inline constexpr std::size_t AUDIO_BANDS = 16;
+using AudioSpectrum                      = std::array<float, AUDIO_BANDS>;
+
+// Wider spectrum for consumers that are not the fixed-16-band scene shader
+// uniforms - currently just the web-wallpaper QML bridge (WebAudioSpectrum),
+// whose JS-side callback convention expects >=64 samples.
+inline constexpr std::size_t AUDIO_BANDS_WIDE = 64;
+using AudioSpectrumWide                       = std::array<float, AUDIO_BANDS_WIDE>;
+
+class AudioCapture {
+public:
+    // Process-wide instance. Never null; safe to use even if capture fails
+    // (it then reports silence forever).
+    static AudioCapture& Instance();
+
+    // Ref-counted device lifetime. Acquire() starts capture on the first
+    // reference; Release() stops it when the last one goes away.
+    void Acquire();
+    void Release();
+
+    // Latest 16-band spectra, each roughly 0..1. Cheap to call many times per
+    // frame: the analysis is computed at most once per ~8ms and cached, so
+    // every node in every scene can call it freely. Returns silence when
+    // capture is unavailable.
+    void GetSpectrum(AudioSpectrum& left, AudioSpectrum& right);
+
+    // Same analysis, 64 log-spaced bands instead of 16. Independent cache
+    // from GetSpectrum() (see .cpp) so a consumer of one resolution doesn't
+    // pay for or invalidate the other's cache.
+    void GetSpectrumWide(AudioSpectrumWide& left, AudioSpectrumWide& right);
+
+    // True once a capture device is actually open and delivering samples.
+    bool active() const;
+
+    AudioCapture(const AudioCapture&)            = delete;
+    AudioCapture& operator=(const AudioCapture&) = delete;
+
+private:
+    AudioCapture();
+    ~AudioCapture();
+    struct Impl;
+    std::unique_ptr<Impl> m_impl;
+};
+
+// RAII helper: hold one of these for as long as a scene needs audio.
+class AudioCaptureRef {
+public:
+    AudioCaptureRef() { AudioCapture::Instance().Acquire(); }
+    ~AudioCaptureRef() { AudioCapture::Instance().Release(); }
+    AudioCaptureRef(const AudioCaptureRef&)            = delete;
+    AudioCaptureRef& operator=(const AudioCaptureRef&) = delete;
+};
+
+} // namespace wallpaper
