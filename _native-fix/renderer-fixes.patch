diff --git a/src/SpecTexs.hpp b/src/SpecTexs.hpp
index 3edbd82..212711c 100644
--- a/src/SpecTexs.hpp
+++ b/src/SpecTexs.hpp
@@ -26,6 +26,13 @@ constexpr std::string_view WE_HALF_COMPO_BUFFER_PREFIX { "_rt_HalfCompoBuffer" }
 constexpr std::string_view WE_QUARTER_COMPO_BUFFER_PREFIX { "_rt_QuarterCompoBuffer" };
 constexpr std::string_view WE_FULL_COMPO_BUFFER_PREFIX { "_rt_FullCompoBuffer" };
 constexpr std::string_view WE_MIP_MAPPED_FRAME_BUFFER { "_rt_MipMappedFrameBuffer" };
+// Shadow atlas: packed depth maps for shadow-casting lights (LIGHTS_SHADOW_MAPPING).
+constexpr std::string_view WE_SHADOW_ATLAS { "_rt_shadowAtlas" };
+// "_alias_" names are engine-provided textures, not files on disk. The only one
