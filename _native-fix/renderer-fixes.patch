diff --git a/src/VideoTex.cpp b/src/VideoTex.cpp
new file mode 100644
index 0000000..97e752b
--- /dev/null
+++ b/src/VideoTex.cpp
@@ -0,0 +1,181 @@
+#include "VideoTex.hpp"
+#include "Utils/Logging.h"
+#include <cstring>
+#include <chrono>
+
+extern "C" {
+#include <libavformat/avformat.h>
+#include <libavcodec/avcodec.h>
+#include <libswscale/swscale.h>
+#include <libavutil/imgutils.h>
+}
+
+namespace wallpaper {
+
+bool LooksLikeVideo(const uint8_t* data, size_t size) {
+    if (size < 12) return false;
+    return data[4] == 'f' && data[5] == 't' && data[6] == 'y' && data[7] == 'p';
+}
+
+namespace
+{
+struct MemBuf { const uint8_t* data; size_t size; size_t pos; };
+
+int read_cb(void* opaque, uint8_t* buf, int bufsz) {
+    auto* m = static_cast<MemBuf*>(opaque);
+    size_t remain = m->size - m->pos;
+    if (remain == 0) return AVERROR_EOF;
+    size_t n = (static_cast<size_t>(bufsz) < remain) ? static_cast<size_t>(bufsz) : remain;
+    std::memcpy(buf, m->data + m->pos, n);
+    m->pos += n;
+    return static_cast<int>(n);
+}
+int64_t seek_cb(void* opaque, int64_t offset, int whence) {
+    auto* m = static_cast<MemBuf*>(opaque);
+    if (whence == AVSEEK_SIZE) return static_cast<int64_t>(m->size);
+    int64_t np;
+    if (whence == SEEK_SET) np = offset;
+    else if (whence == SEEK_CUR) np = static_cast<int64_t>(m->pos) + offset;
+    else if (whence == SEEK_END) np = static_cast<int64_t>(m->size) + offset;
+    else return -1;
+    if (np < 0 || static_cast<size_t>(np) > m->size) return -1;
+    m->pos = static_cast<size_t>(np);
+    return np;
+}
+
+// A minimal open/decoder bundle over an in-memory MP4.
+struct Decoder {
+    MemBuf           mb;
+    AVIOContext*     avio { nullptr };
+    AVFormatContext* fmt { nullptr };
+    AVCodecContext*  ctx { nullptr };
+    SwsContext*      sws { nullptr };
+    int              vstream { -1 };
+    int              w { 0 }, h { 0 };
+
+    bool open(const uint8_t* data, size_t size) {
+        mb = { data, size, 0 };
+        const int BSZ = 1 << 16;
+        uint8_t* avio_buf = static_cast<uint8_t*>(av_malloc(static_cast<size_t>(BSZ)));
+        avio = avio_alloc_context(avio_buf, BSZ, 0, &mb, read_cb, nullptr, seek_cb);
+        fmt = avformat_alloc_context();
+        fmt->pb = avio;
+        if (avformat_open_input(&fmt, nullptr, nullptr, nullptr) < 0) return false;
+        if (avformat_find_stream_info(fmt, nullptr) < 0) return false;
+        vstream = av_find_best_stream(fmt, AVMEDIA_TYPE_VIDEO, -1, -1, nullptr, 0);
+        if (vstream < 0) return false;
+        AVCodecParameters* par = fmt->streams[vstream]->codecpar;
+        const AVCodec* dec = avcodec_find_decoder(par->codec_id);
+        if (! dec) return false;
+        ctx = avcodec_alloc_context3(dec);
+        avcodec_parameters_to_context(ctx, par);
+        if (avcodec_open2(ctx, dec, nullptr) < 0) return false;
+        w = ctx->width; h = ctx->height;
+        return true;
+    }
+    // Decode the next frame into `out` (RGBA8). Returns 1 on frame, 0 on EOF, -1 error.
+    int next(std::vector<uint8_t>& out, AVPacket* pkt, AVFrame* frame) {
+        while (true) {
+            int r = av_read_frame(fmt, pkt);
+            if (r < 0) return 0; // EOF / error -> caller loops
+            if (pkt->stream_index != vstream) { av_packet_unref(pkt); continue; }
+            int sr = avcodec_send_packet(ctx, pkt);
+            av_packet_unref(pkt);
+            if (sr < 0) continue;
+            int rr = avcodec_receive_frame(ctx, frame);
+            if (rr == AVERROR(EAGAIN)) continue;
+            if (rr < 0) return -1;
+            int fw = frame->width, fh = frame->height;
+            if (! sws)
+                sws = sws_getContext(fw, fh, static_cast<AVPixelFormat>(frame->format),
+                                     fw, fh, AV_PIX_FMT_RGBA, SWS_BILINEAR, nullptr, nullptr, nullptr);
+            out.resize(static_cast<size_t>(fw) * static_cast<size_t>(fh) * 4u);
+            uint8_t* dst[4] = { out.data(), nullptr, nullptr, nullptr };
+            int      dstst[4] = { fw * 4, 0, 0, 0 };
+            sws_scale(sws, frame->data, frame->linesize, 0, fh, dst, dstst);
+            return 1;
+        }
+    }
+    void rewind_() {
+        av_seek_frame(fmt, vstream, 0, AVSEEK_FLAG_BACKWARD);
+        avcodec_flush_buffers(ctx);
+    }
+    void close() {
+        if (sws) sws_freeContext(sws);
+        if (ctx) avcodec_free_context(&ctx);
+        if (fmt) avformat_close_input(&fmt);
+        if (avio) { av_freep(&avio->buffer); avio_context_free(&avio); }
+    }
+};
+} // namespace
+
+bool DecodeVideoFirstFrame(const uint8_t* data, size_t size,
+                           std::vector<uint8_t>& out_rgba, int& out_w, int& out_h) {
+    Decoder d;
+    if (! d.open(data, size)) { d.close(); LOG_ERROR("video: open failed"); return false; }
+    AVPacket* pkt = av_packet_alloc();
+    AVFrame*  frame = av_frame_alloc();
+    int r = d.next(out_rgba, pkt, frame);
+    out_w = d.w; out_h = d.h;
+    av_frame_free(&frame); av_packet_free(&pkt);
+    d.close();
+    return r == 1;
+}
+
+VideoPlayer::VideoPlayer(std::shared_ptr<const std::vector<uint8_t>> data) : m_data(std::move(data)) {
+    if (! m_data || m_data->empty()) return;
+    // Probe once so width/height are known immediately (for the initial texture).
+    Decoder probe;
+    if (probe.open(m_data->data(), m_data->size())) {
+        m_w = probe.w; m_h = probe.h; m_ok = true;
+    }
+    probe.close();
+    if (m_ok) m_thread = std::thread([this] { run(); });
+}
+
+VideoPlayer::~VideoPlayer() {
+    m_stop = true;
+    if (m_thread.joinable()) m_thread.join();
+}
+
+bool VideoPlayer::TakeFrame(std::vector<uint8_t>& out) {
+    std::lock_guard<std::mutex> lk(m_mtx);
+    if (! m_has_new) return false;
+    out = m_latest;
+    m_has_new = false;
+    return true;
+}
+
+void VideoPlayer::run() {
+    Decoder d;
+    if (! d.open(m_data->data(), m_data->size())) { d.close(); return; }
+    // Frame duration from the stream's average frame rate (fallback 30fps).
+    AVRational fr = d.fmt->streams[d.vstream]->avg_frame_rate;
+    double fps = (fr.num > 0 && fr.den > 0) ? (double)fr.num / (double)fr.den : 30.0;
+    if (fps < 1.0 || fps > 240.0) fps = 30.0;
+    auto frame_dur = std::chrono::duration<double>(1.0 / fps);
+
+    AVPacket* pkt = av_packet_alloc();
+    AVFrame*  frame = av_frame_alloc();
+    std::vector<uint8_t> buf;
+    auto next_t = std::chrono::steady_clock::now();
+    while (! m_stop) {
+        int r = d.next(buf, pkt, frame);
+        if (r == 0) { d.rewind_(); continue; }        // loop
+        if (r < 0) break;
+        {
+            std::lock_guard<std::mutex> lk(m_mtx);
+            m_latest.swap(buf);
+            m_has_new = true;
+        }
+        // pace to real time
+        next_t += std::chrono::duration_cast<std::chrono::steady_clock::duration>(frame_dur);
+        auto now = std::chrono::steady_clock::now();
+        if (next_t > now) std::this_thread::sleep_for(next_t - now);
+        else next_t = now;                            // fell behind; don't spiral
+    }
+    av_frame_free(&frame); av_packet_free(&pkt);
+    d.close();
+}
+
+} // namespace wallpaper
diff --git a/src/VideoTex.hpp b/src/VideoTex.hpp
new file mode 100644
index 0000000..227712a
--- /dev/null
+++ b/src/VideoTex.hpp
@@ -0,0 +1,57 @@
+#pragma once
+// Video textures: some Wallpaper Engine scenes use a playing MP4/H.264 as a
+// layer texture (the .tex payload is an ISO-BMFF/MP4 stream). This provides a
+// still-frame decode (for the initial texture) and a threaded streaming player
+// that keeps producing frames so the layer can animate.
+#include <cstdint>
+#include <cstddef>
+#include <vector>
+#include <memory>
+#include <thread>
+#include <mutex>
+#include <atomic>
+
+namespace wallpaper {
+
+// Does this buffer start with an MP4/ISO-BMFF 'ftyp' box?
+bool LooksLikeVideo(const uint8_t* data, size_t size);
+
+// Decode the first frame of an in-memory video to tightly-packed RGBA8.
+bool DecodeVideoFirstFrame(const uint8_t* data, size_t size,
+                           std::vector<uint8_t>& out_rgba, int& out_w, int& out_h);
+
+// Streaming player: owns a copy of the video, decodes frames on a worker thread
+// paced to the video's frame rate, and loops. The render loop polls TakeFrame()
+// once per rendered frame and uploads whatever is newest (dropping frames it is
+// too slow to show). All heavy work is off the render thread.
+class VideoPlayer {
+public:
+    // Shares `data` (no copy of the potentially-large stream).
+    VideoPlayer(std::shared_ptr<const std::vector<uint8_t>> data);
+    ~VideoPlayer();
+    VideoPlayer(const VideoPlayer&)            = delete;
+    VideoPlayer& operator=(const VideoPlayer&) = delete;
+
+    bool ok() const { return m_ok; }
+    int  width() const { return m_w; }
+    int  height() const { return m_h; }
+
+    // If a newer decoded frame is ready, copy it into `out` and return true;
+    // otherwise return false (leave `out` untouched). Non-blocking.
+    bool TakeFrame(std::vector<uint8_t>& out);
+
+private:
+    void run();
+
+    std::shared_ptr<const std::vector<uint8_t>> m_data;
+    std::atomic<bool>    m_ok { false };
+    std::atomic<bool>    m_stop { false };
+    int                  m_w { 0 }, m_h { 0 };
+
+    std::mutex           m_mtx;
+    std::vector<uint8_t> m_latest;      // guarded by m_mtx
+    bool                 m_has_new { false };
+    std::thread          m_thread;
+};
+
+} // namespace wallpaper
