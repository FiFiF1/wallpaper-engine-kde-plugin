+    // Image-container textures store their source format (a FreeImage FIF value,
+    // e.g. PNG=13) right after the image count; TEXB0004 added one further field
+    // after it. The original code only read the format, and only for TEXB0003, so
+    // every TEXB0004 texture misaligned - containers read garbage mipmap sizes and
+    // failed, raw ones read as empty. Read the format for TEXB0003+ and skip the
+    // extra field for TEXB0004+.
+    if (header.extraHeader["texb"].val >= 3) {
+        header.type = static_cast<ImageType>(file.ReadInt32());
+        if (header.extraHeader["texb"].val >= 4) file.ReadInt32();
+    }
 }
 
