@@ -498,9 +500,48 @@ ImageSlotsRef TextureCache::CreateTex(Image& image) {
         m_device.handle().WaitIdle();
     }
     m_tex_map[image.key] = std::move(img_slots);
+
+    // If this .tex was actually a video, spin up a decoder and remember the
+    // (cache-owned) image so UpdateVideos() can re-upload frames to it. The
+    // static first frame already uploaded above stays as a fallback.
+    if (image.videoData && ! m_tex_map[image.key].slots.empty()) {
+        auto player = std::make_unique<VideoPlayer>(image.videoData);
+        if (player->ok()) {
+            m_video_texs.push_back(VideoTexEntry {
+                std::move(player), ImageParameters(m_tex_map[image.key].slots.at(0)) });
+        }
+    }
     return m_tex_map[image.key];
 }
 
+void TextureCache::UpdateVideos() {
+    if (m_video_texs.empty()) return;
+    if (! m_tex_cmd) allocateCmd();
+
+    thread_local std::vector<uint8_t> frame;
+    for (auto& vt : m_video_texs) {
+        if (! vt.player->TakeFrame(frame)) continue; // no new frame yet -> keep last
+        const u32 w    = (u32)vt.player->width();
+        const u32 h    = (u32)vt.player->height();
+        const u32 size = w * h * 4u;
+        if (w == 0 || h == 0 || frame.size() < size) continue;
+
+        VmaBufferParameters buf;
+        (void)CreateStagingBuffer(m_device.vma_allocator(), size, buf);
+        {
+            void* v_data;
+            VVK_CHECK(buf.handle.MapMemory(&v_data));
+            memcpy(v_data, frame.data(), size);
+            buf.handle.UnMapMemory();
+        }
+        std::array<BufferParameters, 1> bufs { BufferParameters(buf) };
+        std::array<VkExtent3D, 1>       exts { VkExtent3D { w, h, 1 } };
+        CopyImageData(
+            bufs, exts, m_device.graphics_queue().handle, m_tex_cmd, vt.image);
+        m_device.handle().WaitIdle();
+    }
+}
+
 void TextureCache::allocateCmd() {
     const auto& pool = m_device.cmd_pool();
     VVK_CHECK(pool.Allocate(1, VK_COMMAND_BUFFER_LEVEL_PRIMARY, m_tex_cmds));
