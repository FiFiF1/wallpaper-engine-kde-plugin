@@ -0,0 +1,367 @@
+#include "Audio/AudioCapture.hpp"
+#include "Utils/Logging.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+// Header-only include. The miniaudio implementation is compiled exactly once,
+// in SoundManager.cpp via miniaudio-wrapper.hpp; these MA_NO_* defines must stay
+// identical to that translation unit's or the ma_* struct layouts would differ.
+#define MA_NO_WASAPI
+#define MA_NO_DSOUND
+#define MA_NO_WINMM
+#define MA_NO_COREAUDIO
+#define MA_NO_ENCODING
+#include <miniaudio/miniaudio.h>
+
+namespace wallpaper
+{
+
+namespace
+{
+constexpr std::size_t FFT_SIZE  = 1024;             // ~21ms at 48kHz
+constexpr std::size_t FFT_BINS  = FFT_SIZE / 2;
+constexpr ma_uint32   RATE      = 48000;
+constexpr auto        MIN_PERIOD = std::chrono::milliseconds(8);
+
+// Band edges in Hz, 16 log-spaced bands over the musically useful range.
+constexpr float BAND_EDGES[AUDIO_BANDS + 1] = { 30,   60,   95,   140,  200,  280,
+                                                400,  550,  760,  1050, 1450, 2000,
+                                                2800, 4000, 6000, 9000, 16000 };
+
+// Same range, 64 log-spaced bands - for consumers needing finer resolution
+// than the scene shader uniforms (see AudioCapture.hpp).
+constexpr float BAND_EDGES_WIDE[AUDIO_BANDS_WIDE + 1] = {
+    30.0f,    33.1f,    36.5f,    40.3f,    44.4f,    49.0f,    54.0f,    59.6f,
+    65.8f,    72.5f,    80.0f,    88.3f,    97.4f,    107.4f,   118.5f,   130.7f,
+    144.2f,   159.0f,   175.4f,   193.5f,   213.5f,   235.5f,   259.7f,   286.5f,
+    316.0f,   348.6f,   384.6f,   424.2f,   467.9f,   516.2f,   569.4f,   628.1f,
+    692.8f,   764.2f,   843.0f,   929.9f,   1025.8f,  1131.5f,  1248.2f,  1376.8f,
+    1518.8f,  1675.3f,  1848.1f,  2038.6f,  2248.7f,  2480.5f,  2736.2f,  3018.3f,
+    3329.4f,  3672.7f,  4051.2f,  4468.9f,  4929.6f,  5437.7f,  5998.3f,  6616.6f,
+    7298.7f,  8051.1f,  8881.0f,  9796.6f,  10806.4f, 11920.4f, 13149.3f, 14504.8f,
+    16000.0f,
+};
+
+// In-place iterative radix-2 FFT. `re`/`im` are FFT_SIZE long.
+void fft(float* re, float* im) {
+    // bit-reversal permutation
+    for (std::size_t i = 1, j = 0; i < FFT_SIZE; i++) {
+        std::size_t bit = FFT_SIZE >> 1;
+        for (; j & bit; bit >>= 1) j ^= bit;
+        j ^= bit;
+        if (i < j) {
+            std::swap(re[i], re[j]);
+            std::swap(im[i], im[j]);
+        }
+    }
+    for (std::size_t len = 2; len <= FFT_SIZE; len <<= 1) {
+        const double ang  = -2.0 * M_PI / (double)len;
+        const float  wr_d = (float)std::cos(ang);
+        const float  wi_d = (float)std::sin(ang);
+        for (std::size_t i = 0; i < FFT_SIZE; i += len) {
+            float wr = 1.0f, wi = 0.0f;
+            for (std::size_t k = 0; k < len / 2; k++) {
+                const float ur = re[i + k], ui = im[i + k];
+                const float vr = re[i + k + len / 2] * wr - im[i + k + len / 2] * wi;
+                const float vi = re[i + k + len / 2] * wi + im[i + k + len / 2] * wr;
+                re[i + k]               = ur + vr;
+                im[i + k]               = ui + vi;
+                re[i + k + len / 2]     = ur - vr;
+                im[i + k + len / 2]     = ui - vi;
+                const float nwr         = wr * wr_d - wi * wi_d;
+                wi                      = wr * wi_d + wi * wr_d;
+                wr                      = nwr;
+            }
+        }
+    }
+}
+} // namespace
+
+struct AudioCapture::Impl {
+    // Separate locks by role. `life_mtx` guards refcount + device lifetime;
+    // `mtx` guards only the sample ring and is taken by the realtime audio
+    // callback, so it must never be held while starting/stopping the device.
+    std::mutex life_mtx;
+    std::mutex mtx;                       // guards the sample ring
+    ma_context ctx {};
+    ma_device  dev {};
+    bool       ctx_ok { false };
+    bool       dev_ok { false };
+    bool       running { false };
+    int        refs { 0 };
+    bool       tried { false };           // only attempt device setup once per start
+
+    // Ring of interleaved stereo samples, most recent FFT_SIZE frames.
+    std::array<float, FFT_SIZE> ring_l {};
+    std::array<float, FFT_SIZE> ring_r {};
+    std::size_t                 wpos { 0 };
+    bool                        got_audio { false };
+
+    // Cached analysis output.
+    std::mutex                            out_mtx;
+    AudioSpectrum                         out_l {};
+    AudioSpectrum                         out_r {};
+    std::chrono::steady_clock::time_point last_analysis {};
+    bool                                  have_analysis { false };
+
+    // Independent cache for the wide spectrum: separate smoothing state (the
+    // fast-attack/slow-release memory in analyse_channel_into is per band
+    // count) and a separate due-check, so polling one resolution doesn't
+    // perturb the other's timing.
+    std::mutex                            out_mtx_wide;
+    AudioSpectrumWide                     out_l_wide {};
+    AudioSpectrumWide                     out_r_wide {};
+    std::chrono::steady_clock::time_point last_analysis_wide {};
+    bool                                  have_analysis_wide { false };
+
+    // Windowing table (Hann), precomputed.
+    std::array<float, FFT_SIZE> window {};
+
+    Impl() {
+        for (std::size_t i = 0; i < FFT_SIZE; i++)
+            window[i] = 0.5f * (1.0f - std::cos(2.0f * (float)M_PI * (float)i / (FFT_SIZE - 1)));
+    }
+
+    static void data_cb(ma_device* dev, void*, const void* in, ma_uint32 frames) {
+        auto* self = static_cast<Impl*>(dev->pUserData);
+        if (self == nullptr || in == nullptr) return;
+        const float* f = static_cast<const float*>(in);
+        std::lock_guard<std::mutex> lk(self->mtx);
+        for (ma_uint32 i = 0; i < frames; i++) {
+            self->ring_l[self->wpos] = f[i * 2 + 0];
+            self->ring_r[self->wpos] = f[i * 2 + 1];
+            self->wpos               = (self->wpos + 1) % FFT_SIZE;
+        }
+        if (frames > 0) self->got_audio = true;
+    }
+
+    // Open the monitor source of the DEFAULT SINK. Picking merely the first
+    // ".monitor" device grabs whichever output happens to be enumerated first
+    // (often an idle HDMI port) and captures nothing but silence.
+    bool start() {
+        if (running) return true;
+        if (tried && ! dev_ok) return false;
+        tried = true;
+
+        if (! ctx_ok) {
+            ma_backend backends[] = { ma_backend_pulseaudio, ma_backend_alsa };
+            if (ma_context_init(backends, 2, nullptr, &ctx) != MA_SUCCESS) {
+                LOG_ERROR("audio: context init failed; audio-reactive scenes will see silence");
+                return false;
+            }
+            ctx_ok = true;
+        }
+
+        ma_device_info* play = nullptr;
+        ma_device_info* cap  = nullptr;
+        ma_uint32       nplay = 0, ncap = 0;
+        if (ma_context_get_devices(&ctx, &play, &nplay, &cap, &ncap) != MA_SUCCESS) {
+            LOG_ERROR("audio: device enumeration failed");
+            return false;
+        }
+
+        char want[300];
+        want[0] = '\0';
+        for (ma_uint32 i = 0; i < nplay; i++) {
+            if (play[i].isDefault) {
+                std::snprintf(want, sizeof want, "%s.monitor", play[i].id.pulse);
+                break;
+            }
+        }
+
+        int pick = -1, first_mon = -1;
+        for (ma_uint32 i = 0; i < ncap; i++) {
+            const bool is_mon = std::strstr(cap[i].id.pulse, ".monitor") != nullptr;
+            if (is_mon && first_mon < 0) first_mon = (int)i;
+            if (want[0] != '\0' && std::strcmp(cap[i].id.pulse, want) == 0) pick = (int)i;
+        }
+        if (pick < 0) pick = first_mon;
+        if (pick < 0) {
+            LOG_ERROR("audio: no monitor source found; audio-reactive scenes will see silence");
+            return false;
+        }
+
+        ma_device_config cfg  = ma_device_config_init(ma_device_type_capture);
+        cfg.capture.pDeviceID = &cap[pick].id;
+        cfg.capture.format    = ma_format_f32;
+        cfg.capture.channels  = 2;
+        cfg.sampleRate        = RATE;
+        cfg.dataCallback      = &Impl::data_cb;
+        cfg.pUserData         = this;
+
+        if (ma_device_init(&ctx, &cfg, &dev) != MA_SUCCESS) {
+            LOG_ERROR("audio: capture device init failed");
+            return false;
+        }
+        dev_ok = true;
+        if (ma_device_start(&dev) != MA_SUCCESS) {
+            LOG_ERROR("audio: capture device start failed");
+            ma_device_uninit(&dev);
+            dev_ok = false;
+            return false;
+        }
+        running = true;
+        LOG_INFO("audio: capturing system output from \"%s\"", cap[pick].name);
+        return true;
+    }
+
+    void stop() {
+        if (dev_ok) {
+            ma_device_uninit(&dev);
+            dev_ok = false;
+        }
+        running = false;
+        tried   = false;
+        {
+            std::lock_guard<std::mutex> lk(mtx);
+            got_audio = false;
+            ring_l.fill(0.0f);
+            ring_r.fill(0.0f);
+            wpos = 0;
+        }
+        {
+            std::lock_guard<std::mutex> lk(out_mtx);
+            out_l.fill(0.0f);
+            out_r.fill(0.0f);
+            have_analysis = false;
+        }
+        std::lock_guard<std::mutex> lk(out_mtx_wide);
+        out_l_wide.fill(0.0f);
+        out_r_wide.fill(0.0f);
+        have_analysis_wide = false;
+    }
+
+    // Shared by both band counts: FFT the ring buffer once, then reduce into
+    // whichever band-edge table/output array the caller asks for.
+    template<std::size_t N>
+    void analyse_channel_into(const std::array<float, FFT_SIZE>& src, std::size_t start,
+                              const float (&band_edges)[N + 1], std::array<float, N>& prev) {
+        static thread_local std::vector<float> re, im;
+        re.assign(FFT_SIZE, 0.0f);
+        im.assign(FFT_SIZE, 0.0f);
+        for (std::size_t i = 0; i < FFT_SIZE; i++)
+            re[i] = src[(start + i) % FFT_SIZE] * window[i];
+        fft(re.data(), im.data());
+
+        const float bin_hz = (float)RATE / (float)FFT_SIZE;
+        for (std::size_t b = 0; b < N; b++) {
+            const auto k0 = (std::size_t)std::max(1.0f, band_edges[b] / bin_hz);
+            auto       k1 = (std::size_t)(band_edges[b + 1] / bin_hz);
+            k1            = std::min(k1, FFT_BINS - 1);
+            float peak    = 0.0f;
+            for (std::size_t k = k0; k <= k1 && k < FFT_BINS; k++) {
+                const float mag = std::sqrt(re[k] * re[k] + im[k] * im[k]) * (2.0f / FFT_SIZE);
+                peak            = std::max(peak, mag);
+            }
+            // Magnitude -> dB -> 0..1, matching the rough feel of WE's meters.
+            const float db = 20.0f * std::log10(peak + 1e-7f);
+            float       v  = (db + 62.0f) / 62.0f;
+            v              = std::clamp(v, 0.0f, 1.0f);
+            // Fast attack, slower release, so bars pop on transients but decay
+            // smoothly instead of flickering.
+            prev[b] = v > prev[b] ? v : prev[b] + (v - prev[b]) * 0.28f;
+        }
+    }
+
+    bool snapshot_ring(std::array<float, FFT_SIZE>& l, std::array<float, FFT_SIZE>& r,
+                       std::size_t& start) {
+        std::lock_guard<std::mutex> lk(mtx);
+        if (! got_audio) return false;
+        l     = ring_l;
+        r     = ring_r;
+        start = wpos; // oldest sample
+        return true;
+    }
+
+    void analyse() {
+        std::array<float, FFT_SIZE> l, r;
+        std::size_t                 start;
+        if (! snapshot_ring(l, r, start)) return;
+        std::lock_guard<std::mutex> lk(out_mtx);
+        analyse_channel_into<AUDIO_BANDS>(l, start, BAND_EDGES, out_l);
+        analyse_channel_into<AUDIO_BANDS>(r, start, BAND_EDGES, out_r);
+        have_analysis = true;
+    }
+
+    void analyse_wide() {
+        std::array<float, FFT_SIZE> l, r;
+        std::size_t                 start;
+        if (! snapshot_ring(l, r, start)) return;
+        std::lock_guard<std::mutex> lk(out_mtx_wide);
+        analyse_channel_into<AUDIO_BANDS_WIDE>(l, start, BAND_EDGES_WIDE, out_l_wide);
+        analyse_channel_into<AUDIO_BANDS_WIDE>(r, start, BAND_EDGES_WIDE, out_r_wide);
+        have_analysis_wide = true;
+    }
+};
+
+AudioCapture::AudioCapture(): m_impl(std::make_unique<Impl>()) {}
+AudioCapture::~AudioCapture() {
+    if (m_impl) {
+        m_impl->stop();
+        if (m_impl->ctx_ok) ma_context_uninit(&m_impl->ctx);
+    }
+}
+
+AudioCapture& AudioCapture::Instance() {
+    static AudioCapture inst;
+    return inst;
+}
+
+void AudioCapture::Acquire() {
+    std::lock_guard<std::mutex> lk(m_impl->life_mtx);
+    if (m_impl->refs++ == 0) m_impl->start();
+}
+
+void AudioCapture::Release() {
+    std::lock_guard<std::mutex> lk(m_impl->life_mtx);
+    if (m_impl->refs > 0 && --m_impl->refs == 0) m_impl->stop();
+}
+
+bool AudioCapture::active() const { return m_impl->running && m_impl->got_audio; }
+
+void AudioCapture::GetSpectrum(AudioSpectrum& left, AudioSpectrum& right) {
+    if (! m_impl->running) {
+        left.fill(0.0f);
+        right.fill(0.0f);
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    bool       due = false;
+    {
+        std::lock_guard<std::mutex> lk(m_impl->out_mtx);
+        due = ! m_impl->have_analysis || (now - m_impl->last_analysis) >= MIN_PERIOD;
+        if (due) m_impl->last_analysis = now;
+    }
+    if (due) m_impl->analyse();
+
+    std::lock_guard<std::mutex> lk(m_impl->out_mtx);
+    left  = m_impl->out_l;
+    right = m_impl->out_r;
+}
+
+void AudioCapture::GetSpectrumWide(AudioSpectrumWide& left, AudioSpectrumWide& right) {
+    if (! m_impl->running) {
+        left.fill(0.0f);
+        right.fill(0.0f);
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    bool       due = false;
+    {
+        std::lock_guard<std::mutex> lk(m_impl->out_mtx_wide);
+        due = ! m_impl->have_analysis_wide || (now - m_impl->last_analysis_wide) >= MIN_PERIOD;
+        if (due) m_impl->last_analysis_wide = now;
+    }
+    if (due) m_impl->analyse_wide();
+
+    std::lock_guard<std::mutex> lk(m_impl->out_mtx_wide);
+    left  = m_impl->out_l_wide;
+    right = m_impl->out_r_wide;
+}
+
+} // namespace wallpaper
